{
  "version": 2,
  "profile": "spec-kit",
  "project": {
    "name": "thinking-mcp"
  },
  "integrations": {
    "specKit": {
      "enabled": true,
      "discovery": {
        "featureRoot": "specs",
        "strategy": "explicit",
        "requireUniqueMatch": true
      },
      "taskExecution": {
        "mode": "batch",
        "batch": { "maximumTasks": 3, "respectDependencies": true, "groupParallelTasks": true }
      },
      "markdownCheckboxPolicy": "hint",
      "completion": {
        "requireAllRequiredTasksCompleted": true,
        "requireAcceptanceCriteriaCoverage": true,
        "requireNoUnresolvedPlanChanges": true,
        "requireCurrentArtifactSnapshot": true
      }
    }
  },
  "workflow": {
    "file": "workflow.json"
  },
  "responses": {
    "file": "responses.json"
  },
  "operations": {
    "file": "operations.json"
  },
  "downstreamServers": {
    "file": "downstream-servers.json"
  },
  "policies": {
    "file": "policies.json"
  },
  "state": {
    "directory": "state",
    "persistAfterEveryOperation": true,
    "retainRawMcpResponses": true
  },
  "chain": {
    "enabled": true,
    "maxChainDepth": 16,
    "maxStepsPerManifest": 16
  },
  "orchestration": {
    "defaultTimeoutSeconds": 120,
    "defaultRetryCount": 0,
    "maximumConcurrentOperations": 4,
    "failClosedForRequiredOperations": true
  },
  "security": {
    "allowAgentDefinedServers": false,
    "allowAgentDefinedOperations": false,
    "allowAgentProvidedCommands": false,
    "restrictWorkingDirectory": true,
    "redactSensitiveOutput": true
  }
}
