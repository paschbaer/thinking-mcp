{
  "version": 2,
  "responses": {
    "understand": {
      "title": "Understand the Request",
      "instruction": "Analyze the development request before proposing an implementation, using the Clear-Thought tools: run at least one sequential_thinking pass to structure the analysis and reference its conclusions in the submission. Provide a concise summary, assumptions, open questions, constraints, risks, measurable acceptance criteria, and affected areas. Do not create an implementation plan yet. Set up your terminal shell first: run all commands through wsl.exe -e bash (this repo's shell; a shell field in guidance.json is rejected by the server's strict config validation, so it is defined here — revisit once config validation becomes tolerant). Ask open questions in the chat before submitting and reference them in `openQuestions`; escalate via `report_blocker` ONLY when the answer would materially change this submission (a different plan or different code) — otherwise document the question, state your working assumption explicitly, and proceed.",
      "requiredActions": [
        "Inspect the relevant repository context.",
        "Run at least one Clear-Thought sequential_thinking pass and reference its conclusions in the submission.",
        "Distinguish confirmed facts from assumptions.",
        "Identify blocking questions explicitly."
      ]
    },
    "plan": {
      "title": "Create the Implementation Plan",
      "instruction": "Create a concrete implementation plan with stable task identifiers, affected files, dependencies, planned tests, and verification, using the Clear-Thought tools: decompose and prioritize via sequential_thinking (and decision_framework when weighing alternatives), and reference the reasoning results in the submission. Do not start implementation yet. Ask open questions in the chat before submitting and reference them in `openQuestions`; escalate via `report_blocker` ONLY when the answer would materially change this submission (a different plan or different code) — otherwise document the question, state your working assumption explicitly, and proceed.",
      "requiredActions": [
        "Run at least one Clear-Thought sequential_thinking or decision_framework pass for decomposition/prioritization and reference its results in the plan submission."
      ]
    },
    "review_and_adjust_plan": {
      "title": "Review and Adjust the Plan",
      "instruction": "Review the plan critically from architecture, correctness, maintainability, testability, security, backward-compatibility, performance, and operational perspectives, using the Clear-Thought tools: stress-test the plan's assumptions with assumption_xray, socratic_method, or argument_map, and reference the reasoning results in the findings. Submit the complete adjusted plan. Ask open questions in the chat before submitting and reference them in `remainingConcerns`; escalate via `report_blocker` ONLY when the answer would materially change this submission (a different plan or different code) — otherwise document the question, state your working assumption explicitly, and proceed.",
      "requiredActions": [
        "Run at least one Clear-Thought stress-test pass (assumption_xray, socratic_method, or argument_map) and reference its results in the findings."
      ]
    },
    "implement": {
      "title": "Implement the Approved Plan",
      "instruction": "Implement the approved plan. Follow the approved task identifiers, avoid unrelated changes, and report all changed, created, and deleted files plus deviations. FIRST step: verify you are in the expected checkout (git status — the main checkout, or a worktree under /workspace/worktrees/<name> when the session was started there), then ensure a feature branch (feature/<meaningful-name>) exists for this work. For PARALLEL work use a worktree under /workspace/worktrees (docker-compose.override.yml mounts it) and start the session with that workspaceRoot — run npm install once inside the worktree so the build/test gates work. LAST step: update the documentation (README.md — documentation is always written in English) and the memory-bank files. Ask open questions in the chat before submitting and reference them in `unresolvedIssues` (together with `deviations`); escalate via `report_blocker` ONLY when the answer would materially change this submission (a different plan or different code) — otherwise document the question, state your working assumption explicitly, and proceed.",
      "requiredActions": []
    },
    "review_and_fix_implementation": {
      "title": "Review and Fix the Implementation",
      "instruction": "Review the implementation for correctness, edge cases, error handling, security, maintainability, duplication, dead code, performance, compatibility, test coverage, and plan conformity. Apply fixes before submitting, using the Clear-Thought tools: run metacognitive_monitoring as a final confidence check before submitting, and debugging_approach for non-trivial findings — reference the results in the findings. For non-trivial scopes (core engine, shared modules, security- or state-machine-relevant changes) the review MUST include an INDEPENDENT reviewer pass (review sub-agent with authorship excluded) over the semantic diff against the governing spec — self-review alone is insufficient. Apply the boundary checklist to every changed code path: (a) boundary values (</==/> on limits, indexes, counts); (b) concurrency, replay and idempotency (same request twice, concurrent callers); (c) optional configuration fields OMITTED by the caller (do not test only the set case); (d) ordering of guard/gate checks relative to exhaustion/termination checks. Ask open questions in the chat before submitting and reference them in `unresolvedFindings`; escalate via `report_blocker` ONLY when the answer would materially change this submission (a different plan or different code) — otherwise document the question, state your working assumption explicitly, and proceed.",
      "requiredActions": [
        "Run Clear-Thought metacognitive_monitoring as a final confidence check before submitting; when findings are non-trivial, additionally apply debugging_approach and reference its results in the findings."
      ]
    },
    "verify": {
      "title": "Verify the Implementation",
      "instruction": "Guidance will execute the configured verification operations. Analyze failures and return to implementation review when code changes are required. Do not claim success while a mandatory operation is failing.",
      "requiredActions": []
    },
    "complete": {
      "title": "Complete the Workflow",
      "instruction": "Produce the final completion report: summary, changed files, verification results, known limitations, remaining risks, deviations, deferred work, and next steps. MANDATORY FINAL REVIEW — BEFORE producing the report: run an INDEPENDENT final review in a FRESH sub-agent (review tool with authorship excluded, e.g. spawn_agent) over ALL tasks of this session: hand it the complete diff of all commits/changes of this session, the governing spec, and the focus areas cross-task interactions, spec conformance, fail-closed invariants, boundary cases (limits, concurrency/replay/idempotency, omitted optional config), and test coverage adequacy; require an evidence table per finding and an explicit count of open HIGH/CRITICAL findings. Fix every HIGH/CRITICAL finding before completing (with regression coverage); persist every remaining finding in memory-bank/remaining-work-plan.md AND memory-bank/activeContext.md (Findings Lifecycle Rule) and reference the review outcome (scope, findings count, fixes) in the completion report. Completing with open HIGH/CRITICAL findings is not allowed. BEFORE submitting the completion report: (1) refresh the GitNexus index host-side by running this exact command in the terminal: wsl.exe -e bash -lc 'export NVM_DIR=$HOME/.nvm && . $NVM_DIR/nvm.sh && cd /mnt/d/repos/Thinking-MCP && gitnexus analyze --no-stats' (gitnexus lives behind nvm in WSL — a plain 'gitnexus' call fails with command not found; per AGENTS.md the gate only verifies index availability, not freshness) and note the refresh in the report; (2) review this session for recurring bugs, traps, and validated fixes per .github/prompts/capture-lessons.prompt.md, and write validated lessons (redacted, [{slug, observation, cause, fix}]) to .guidance/state/session-lessons.json — ALWAYS create the file, using an empty array if there are no validated lessons; (3) remaining-work impact review: check memory-bank/remaining-work-plan.md for tracked follow-ups resolved, touched, or newly created by this run and update the plan accordingly (status changes, new entries with trigger point and action classification). Guidance then seeds this file into the experience-memory server (capture-session-lessons gate) and runs all mandatory completion operations before completion. The final-review mandate is machine-enforced by the required operation `final-review-gate` (amendment 003): write `.guidance/state/final-review.json` (strict schema, headCommit == HEAD, openHighCritical 0, evidence per finding) AFTER the last commit — any commit after the review invalidates the gate. Ask open questions in the chat before submitting and reference them in `deferredWork`/`nextSteps`; escalate via `report_blocker` ONLY when the answer would materially change this submission (a different plan or different code) — otherwise document the question, state your working assumption explicitly, and proceed.",
      "requiredActions": [
        "Run an independent final review in a fresh, authorship-excluded sub-agent over ALL tasks of this session (full session diff + governing spec + boundary/concurrency/coverage focus), with an evidence table per finding and an explicit HIGH/CRITICAL count.",
        "Fix every HIGH/CRITICAL finding before completing (regression coverage); persist all remaining findings in memory-bank/remaining-work-plan.md and memory-bank/activeContext.md.",
        "Reference the final-review outcome (scope, findings count, fixes) in the completion report."
      ]
    }
  }
}
