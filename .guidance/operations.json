{
  "version": 2,
  "operations": {
    "lint": {
      "description": "Check formatting with Prettier. Non-blocking: CRLF checkouts on Windows can still fail this in the Linux container (run `npm run format` from the workspace root when it does).",
      "type": "process",
      "executable": "npx",
      "args": ["prettier", "--check", "servers/*/src/**/*.{ts,tsx}"],
      "required": false,
      "timeoutSeconds": 300,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "normalized", "retainRawResult": true }
    },
    "test": {
      "description": "Run the automated test suite (npm test --workspaces). Linux-native node_modules come from deps-install/deps-reinstall in-container (specs/015 US2). Non-blocking for now: the container suite currently crashes at vitest worker teardown (node RemoveEnvironmentCleanupHook assert with native addons — tracked DEPLOY-015c); the WSL host suite is the authoritative signal until then.",
      "type": "process",
      "executable": "npm",
      "args": ["test"],
      "required": false,
      "timeoutSeconds": 900,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "normalized", "retainRawResult": true }
    },
    "deps-install": {
      "description": "Install Node dependencies: npm ci clean semantics with fallback to npm install when no lockfile exists (the result's via label records which strategy ran — audit note). riskClass workspace_write (FR-053 approval), exposure-filtered output (specs/015 FR-1211).",
      "type": "composite",
      "strategy": "firstAvailable",
      "required": false,
      "invocableByAgent": true,
      "timeoutSeconds": 900,
      "riskClass": "workspace_write",
      "steps": [
        {
          "type": "process",
          "capability": "npm-ci-lockfile",
          "executable": "npm",
          "args": ["ci"]
        },
        {
          "type": "process",
          "capability": "npm-install-fallback",
          "executable": "npm",
          "args": ["install"]
        }
      ],
      "validation": {
        "protocolRequestMustSucceed": true,
        "exitCodeMustBeZero": true
      },
      "output": { "returnToAgent": "normalized", "retainRawResult": true }
    },
    "deps-reinstall": {
      "description": "Clean Node dependencies: delete node_modules (lockfile preserved), then reinstall — workspace-scoped (runs in the workspace root, no path traversal). For native-addon ABI mismatches (ERR_DLOPEN_FAILED): reinstall INSIDE the container for a Linux-native tree. riskClass workspace_write (FR-053 approval), exposure-filtered output (specs/015 FR-1212).",
      "type": "process",
      "executable": "node",
      "args": [
        "-e",
        "const cp=require('node:child_process'),fs=require('node:fs');fs.rmSync('node_modules',{recursive:true,force:true});const r=cp.spawnSync('npm',['install'],{stdio:'inherit'});process.exit(r.status??1)"
      ],
      "required": false,
      "invocableByAgent": true,
      "timeoutSeconds": 900,
      "riskClass": "workspace_write",
      "validation": {
        "protocolRequestMustSucceed": true,
        "exitCodeMustBeZero": true
      },
      "output": { "returnToAgent": "normalized", "retainRawResult": true }
    },
    "build": {
      "description": "Build the project.",
      "type": "process",
      "executable": "npm",
      "args": ["run", "build"],
      "required": true,
      "timeoutSeconds": 600,
      "riskClass": "workspace_write",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "normalized", "retainRawResult": true }
    },
    "docs-drift": {
      "description": "Documentation-Drift-Gate (specs/010, FR-951/952): read-only deterministic checks — README tool table vs. tool-name sources, assistant question catalog, ERROR_CODES table coverage, spec status hygiene. Fails closed on missing README; exit 1 on any finding.",
      "type": "process",
      "executable": "node",
      "args": ["servers/server-guidance/scripts/check-docs-drift.mjs", "."],
      "required": true,
      "timeoutSeconds": 60,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "normalized", "retainRawResult": true }
    },
    "final-review-gate": {
      "description": "Final-Review Evidence Gate (amendment 003, FR-120/121): validates .guidance/state/final-review.json — strict schema, headCommit == HEAD (any commit after the review invalidates the gate), no open HIGH/CRITICAL findings.",
      "type": "process",
      "executable": "node",
      "args": ["servers/server-guidance/scripts/check-final-review.mjs", "."],
      "required": true,
      "timeoutSeconds": 60,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "normalized", "retainRawResult": true }
    },
    "index-freshness": {
      "description": "Verify the GitNexus index is FRESH: .gitnexus/meta.json (lastCommit + branch) must match git HEAD. Deterministic freshness check (GUID-6) — the git state is resolved by reading .git files, no git binary required. Refresh host-side via gitnexus analyze --no-stats.",
      "type": "process",
      "executable": "node",
      "args": ["servers/server-guidance/scripts/check-index-freshness.mjs", "."],
      "required": true,
      "timeoutSeconds": 60,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "normalized", "retainRawResult": true }
    },
    "gitnexus-check": {
      "description": "Risk-class assignment for the gitnexus `check` tool (WC-1-B): wildcard server + no operations entry would fail authorization_required; this read-only entry assigns the risk class so composite gates (repository-analysis) and run_operation can invoke it.",
      "type": "mcpTool",
      "server": "gitnexus",
      "capability": "check",
      "arguments": { "mode": "template", "value": { "repo": "thinking-mcp" } },
      "required": false,
      "timeoutSeconds": 60,
      "riskClass": "read_only",
      "invocableByAgent": true,
      "output": { "returnToAgent": "normalized", "retainRawResult": false }
    },
    "repository-analysis": {
      "description": "Verify the GitNexus index for this repo is present and queryable (HTTP mode: mcpTool check; stdio mode: local CLI refresh via analyze --no-stats). The index REFRESH itself stays a host-side pre-complete step (AGENTS.md): the HTTP server exposes no analyze tool.",
      "type": "composite",
      "strategy": "firstAvailable",
      "required": true,
      "timeoutSeconds": 900,
      "riskClass": "read_only",
      "steps": [
        {
          "type": "mcpTool",
          "server": "gitnexus",
          "capability": "check",
          "arguments": { "mode": "template", "value": { "repo": "thinking-mcp" } }
        },
        {
          "type": "process",
          "executable": "gitnexus",
          "args": ["analyze", "--no-stats"]
        }
      ],
      "validation": {
        "protocolRequestMustSucceed": true,
        "toolResultMustNotBeError": true,
        "requiredContent": true
      },
      "output": { "returnToAgent": "normalized", "retainRawResult": true },
      "failure": { "remainInPhase": true, "allowManualRetry": true, "reportToAgent": true }
    },
    "query-project-insights": {
      "description": "Retrieve existing development insights (experience_search).",
      "type": "mcpTool",
      "server": "insight",
      "capability": "experience_search",
      "required": false,
      "timeoutSeconds": 60,
      "riskClass": "read_only",
      "arguments": {
        "mode": "template",
        "value": { "query": "${session.request}", "scope_id": "${project.name}" }
      },
      "validation": { "protocolRequestMustSucceed": true, "toolResultMustNotBeError": true },
      "output": { "returnToAgent": "normalized", "retainRawResult": false }
    },
