      "description": "Orchestrated Clear-Thought sequential_thinking pass (timeout-resilient route: guidance ClientManager with reconnect instead of the editor's direct MCP connection). Used for the workflow-mandated reasoning minimum (AGENTS.md); ad-hoc reasoning stays on the editor tools.",
      "type": "mcpTool",
      "server": "clearthought",
      "capability": "sequential_thinking",
      "invocableByAgent": true,
      "required": false,
      "timeoutSeconds": 120,
      "riskClass": "read_only",
      "arguments": {
        "mode": "template",
        "value": {
          "thought": "${session.request}",
