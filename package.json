{
    "name": "@paschbaer/thinking-mcp",
    "version": "0.0.1",
    "private": true,
    "description": "Thinking-focused MCP servers: Clear Thought and Stochastic Thinking",
    "workspaces": [
        "servers/*"
    ],
    "dependenciesMeta": {
        "better-sqlite3": {
            "built": true
        }
    },
    "scripts": {
        "build": "npm run build --workspaces",
        "watch": "npm run watch --workspaces",
        "test": "npm test --workspaces",
        "docker:build": "npm run docker:build --workspaces",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "publish:stochastic": "cd servers/server-stochasticthinking && node scripts/publish-smithery.mjs",
        "publish:clear-thought": "cd servers/server-clear-thought && node scripts/publish-smithery.mjs",
        "npm:publish:stochastic": "cd servers/server-stochasticthinking && npm publish",
        "npm:publish:clear-thought": "cd servers/server-clear-thought && npm publish"
    },
    "author": "paschbaer",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/paschbaer/thinking-mcp.git"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@types/node": "^22.13.4",
        "prettier": "^3.1.0",
        "typescript": "^5.7.3"
    },
    "packageManager": "yarn@4.6.0+sha512.5383cc12567a95f1d668fbe762dfe0075c595b4bfff433be478dbbe24e05251a8e8c3eb992a986667c1d53b6c3a9c85b8398c35a960587fbd9fa3a0915406728"
}
