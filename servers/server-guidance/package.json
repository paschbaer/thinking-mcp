{
  "name": "@paschbaer/guidance",
  "version": "0.1.0",
  "description": "Guidance MCP Server \u2014 configurable workflow orchestrator with Spec-Kit integration profile. Functionality defined by specs/002-guidance-workflow-server/spec.md",
  "license": "MIT",
  "author": "Paschbaer",
  "homepage": "https://github.com/paschbaer/thinking-mcp/tree/main/servers/server-guidance",
  "bugs": "https://github.com/paschbaer/thinking-mcp/issues",
  "type": "module",
  "bin": {
    "mcp-server-guidance": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "echo \"No linting configured\" && exit 0",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/server.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/server.js",
    "watch": "npx tsc --watch",
    "prepare": "npm run build",
    "prebuild": "npm run clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paschbaer/thinking-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^4.18.2",
    "zod": "^3.25.27"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^1.6.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
