{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "outcome"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "implementation_changes_required",
        "batch_approved_more_pending",
        "submission_valid"
      ]
    },
    "findings": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "filesChangedDuringReview": {
      "type": "array",
      "items": { "type": "string" }
    },
    "testsAddedOrUpdated": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolvedFindings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
