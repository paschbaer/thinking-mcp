{
  "version": 2,
  "operations": {
    "lint": {
      "description": "Run the configured linter.",
      "type": "process",
      "executable": "npm",
      "args": ["run", "lint"],
      "required": true,
      "timeoutSeconds": 300,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "test": {
      "description": "Run the automated test suite.",
      "type": "process",
      "executable": "npm",
      "args": ["test"],
      "required": true,
      "timeoutSeconds": 900,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "build": {
      "description": "Build the project.",
      "type": "process",
      "executable": "npm",
      "args": ["run", "build"],
      "required": true,
      "timeoutSeconds": 600,
      "riskClass": "workspace_write",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "repository-analysis": {
      "description": "Analyze the repository using GitNexus (fallback: local CLI).",
      "type": "composite",
      "strategy": "firstAvailable",
      "required": true,
      "timeoutSeconds": 900,
      "riskClass": "workspace_write",
      "steps": [
        {
          "type": "mcpTool",
          "server": "gitnexus",
          "capability": "analyze",
          "arguments": { "mode": "fixed", "value": { "noStats": true } }
        },
        {
          "type": "process",
          "executable": "gitnexus",
          "args": ["analyze", "--no-stats"]
        }
      ],
      "validation": {
        "protocolRequestMustSucceed": true,
        "toolResultMustNotBeError": true,
        "requiredContent": true
      },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true },
      "failure": { "remainInPhase": true, "allowManualRetry": true, "reportToAgent": true }
    },
    "query-project-insights": {
      "description": "Retrieve existing development insights.",
      "type": "mcpTool",
      "server": "insight",
      "capability": "query_insights",
      "required": false,
      "timeoutSeconds": 60,
      "riskClass": "read_only",
      "arguments": {
        "mode": "template",
        "value": { "query": "${session.request}", "scope": "${project.name}" }
      },
      "validation": { "protocolRequestMustSucceed": true, "toolResultMustNotBeError": true },
      "output": { "returnToAgent": "normalized", "retainRawResult": false }
    },
    "store-completion-insight": {
      "description": "Store a completion insight for the finished feature.",
      "type": "mcpTool",
      "server": "insight",
      "capability": "store_insight",
      "required": false,
      "timeoutSeconds": 60,
      "riskClass": "external_write",
      "arguments": {
        "mode": "template",
        "value": { "summary": "${phase.completionReport.summary}" }
      },
      "validation": { "protocolRequestMustSucceed": true, "toolResultMustNotBeError": true },
      "output": { "returnToAgent": "status_only", "retainRawResult": false }
    }
  }
}
