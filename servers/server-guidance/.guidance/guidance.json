{
  "version": 2,
  "profile": "plain",
  "project": {
    "name": "my-project"
  },
  "workflow": {
    "file": "workflow.json"
  },
  "responses": {
    "file": "responses.json"
  },
  "operations": {
    "file": "operations.json"
  },
