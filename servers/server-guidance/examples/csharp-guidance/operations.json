{
  "version": 2,
  "operations": {
    "toolchain-sync": {
      "description": "Restore the pinned NuGet dependencies from packages.lock.json (network: nuget.org). Fail-closed on a missing or stale lockfile (--locked-mode). Requires <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile> and a committed packages.lock.json per project.",
      "type": "process",
      "executable": "dotnet",
      "args": ["restore", "--locked-mode"],
      "required": false,
      "timeoutSeconds": 900,
      "riskClass": "workspace_write",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "lint": {
      "description": "Verify formatting and analyzer fixes without mutating files (dotnet format --verify-no-changes).",
      "type": "process",
      "executable": "dotnet",
      "args": ["format", "--verify-no-changes"],
      "required": true,
      "timeoutSeconds": 600,
      "riskClass": "read_only",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "test": {
      "description": "Run the test suite (dotnet test --no-restore).",
      "type": "process",
      "executable": "dotnet",
      "args": ["test", "--no-restore"],
      "required": true,
      "timeoutSeconds": 900,
      "riskClass": "read_only",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "check": {
      "description": "Compile the solution without restoring (dotnet build --no-restore; includes analyzer warnings).",
      "type": "process",
      "executable": "dotnet",
      "args": ["build", "--no-restore"],
      "required": true,
      "timeoutSeconds": 600,
      "riskClass": "read_only",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "final-review-gate": {
      "description": "Final-Review Evidence Gate (amendment 003, FR-120/121): validates .guidance/state/final-review.json — strict schema, headCommit == HEAD (any commit after the review invalidates the gate), no open HIGH/CRITICAL findings.",
      "type": "process",
      "executable": "node",
      "args": ["servers/server-guidance/scripts/check-final-review.mjs", "."],
      "required": true,
      "timeoutSeconds": 60,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    }
  }
}
