{
  "version": 2,
  "operations": {
    "toolchain-sync": {
      "description": "Fetch the pinned Rust dependencies from Cargo.lock into the cargo registry cache (network: crates.io). Fail-closed on a missing or stale Cargo.lock (--locked).",
      "type": "process",
      "executable": "cargo",
      "args": ["fetch", "--locked"],
      "required": false,
      "timeoutSeconds": 900,
      "riskClass": "workspace_write",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "lint": {
      "description": "Run clippy over the workspace (cargo clippy --locked, warnings denied).",
      "type": "process",
      "executable": "cargo",
      "args": ["clippy", "--locked", "--", "-D", "warnings"],
      "required": true,
      "timeoutSeconds": 900,
      "riskClass": "read_only",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "fmt-check": {
      "description": "Check formatting (cargo fmt --check).",
      "type": "process",
      "executable": "cargo",
      "args": ["fmt", "--check"],
      "required": true,
      "timeoutSeconds": 120,
      "riskClass": "read_only",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "test": {
      "description": "Run the test suite (cargo test --locked).",
      "type": "process",
      "executable": "cargo",
      "args": ["test", "--locked"],
      "required": true,
      "timeoutSeconds": 900,
      "riskClass": "read_only",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "check": {
      "description": "Type-check the workspace without codegen (cargo check --locked).",
      "type": "process",
      "executable": "cargo",
      "args": ["check", "--locked"],
      "required": true,
      "timeoutSeconds": 600,
      "riskClass": "read_only",
      "invocableByAgent": true,
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    },
    "final-review-gate": {
      "description": "Final-Review Evidence Gate (amendment 003, FR-120/121): validates .guidance/state/final-review.json — strict schema, headCommit == HEAD (any commit after the review invalidates the gate), no open HIGH/CRITICAL findings.",
      "type": "process",
      "executable": "node",
      "args": ["servers/server-guidance/scripts/check-final-review.mjs", "."],
      "required": true,
      "timeoutSeconds": 60,
      "riskClass": "read_only",
      "validation": { "protocolRequestMustSucceed": true, "exitCodeMustBeZero": true },
      "output": { "returnToAgent": "summary_and_errors", "retainRawResult": true }
    }
  }
}
