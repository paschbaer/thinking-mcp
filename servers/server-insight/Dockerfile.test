# Test image for the insight suite: runs the full vitest suite on the
# deployment base image (node:22-slim, glibc) with platform-correct
# better-sqlite3 bindings — the deterministic alternative to flaky
# WSL/Node-24/drvfs runs (native worker-exit crashes).
#
# Build context is the REPO ROOT (the suite also reads repo siblings:
# servers/shared-workflow and servers/server-guidance/scripts).
#   docker build -f servers/server-insight/Dockerfile.test -t insight-test:local .
# Run:
#   docker run --rm -e EMMS_DISABLE_EMBEDDINGS=1 insight-test:local
#   (or bash servers/server-insight/scripts/test-in-container.sh for
#    build + 2 consecutive full runs)
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY servers/server-insight/package*.json ./

# Deterministic install from the committed lockfile; better-sqlite3 (and
# sharp, whose install script --ignore-scripts skips) rebuilt for this
# platform exactly like the deployment image.
RUN npm ci --ignore-scripts
RUN npm rebuild better-sqlite3 sharp

COPY servers/server-insight/ .
# Repo siblings read by contract/unit tests (vendored-copy hash + seed gate)
COPY servers/shared-workflow/ /usr/src/shared-workflow/
COPY servers/server-guidance/scripts/ /usr/src/server-guidance/scripts/

CMD ["npx", "vitest", "run"]
