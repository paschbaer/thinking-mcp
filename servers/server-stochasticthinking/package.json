{
    "name": "@paschbaer/stochasticthinking",
    "version": "0.0.1",
    "description": "MCP server for stochastic algorithms and probabilistic decision making",
    "license": "MIT",
    "author": "Paschbaer",
    "homepage": "https://github.com/paschbaer/thinking-mcp/tree/main/servers/server-stochasticthinking",
    "bugs": "https://github.com/paschbaer/thinking-mcp/issues",
    "type": "module",
    "bin": {
        "mcp-server-stochasticthinking": "dist/dev.js"
    },
    "files": [
        "dist",
        "AGENTS.template.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:smithery": "npx @smithery/cli build",
        "test": "vitest run",
        "test:live": "node scripts/funktionstest.mjs",
        "test:coverage": "vitest --coverage",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "lint": "echo \"No linting configured\" && exit 0",
        "docker:build": "docker build -t paschbaer/stochasticthinking .",
        "docker:run": "docker run -p 3001:3000 paschbaer/stochasticthinking",
        "dev": "tsx src/dev.ts",
        "dev:http": "tsx src/server.ts",
        "start": "node dist/server.js",
        "start:http": "node dist/server.js",
        "watch": "npx tsc --watch",
        "prepare": "npm run build",
        "prebuild": "npm run clean",
        "prepublishOnly": "npm run build",
        "deploy": "smithery deploy"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/paschbaer/thinking-mcp.git"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@smithery/sdk": "^1.4.3",
        "express": "^4.18.2",
        "zod": "^3.25.27"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22",
        "@vitest/coverage-v8": "^1.2.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vitest": "^1.2.0"
    },
    "keywords": [
        "mcp",
        "sequential-thinking",
        "stochastic-algorithms",
        "probabilistic-decision-making",
        "markov-decision-process",
        "monte-carlo",
        "reinforcement-learning",
        "ai",
        "cognitive-tools"
    ],
    "engines": {
        "node": ">=20"
    }
}
