# Copy to .env (server dir or repo root) and fill in your key.
# .env is gitignored — never commit real keys.
#
# Actor = solves the tasks, Judge = scores the answers (independent models
# avoid same-model self-bias). Judge inherits base URL + key from the actor
# unless EVAL_JUDGE_BASE_URL / EVAL_JUDGE_API_KEY are set.

EVAL_ACTOR_BASE_URL=https://api.z.ai/api/coding/paas/v4
EVAL_ACTOR_API_KEY=your-key-here
EVAL_ACTOR_MODEL=glm-5.3-flash
EVAL_JUDGE_MODEL=glm-5.3
