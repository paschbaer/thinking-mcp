{
    "name": "@paschbaer/experiencememory",
    "version": "0.1.0",
    "description": "Experience Memory MCP Server (EMMS) - evidence-backed long-term memory layer for coding agents. Functionality defined by specs/001-experience-memory-server/spec.md",
    "license": "MIT",
    "author": "Paschbaer",
    "homepage": "https://github.com/paschbaer/thinking-mcp/tree/main/servers/server-experiencememory",
    "bugs": "https://github.com/paschbaer/thinking-mcp/issues",
    "type": "module",
    "bin": {
        "mcp-server-experiencememory": "dist/dev.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:coverage": "vitest --coverage",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "lint": "echo \"No linting configured\" && exit 0",
        "dev": "tsx src/dev.ts",
        "dev:http": "tsx src/server.ts",
        "start": "node dist/server.js",
        "start:http": "node dist/server.js",
        "watch": "npx tsc --watch",
        "prepare": "npm run build",
        "prebuild": "npm run clean",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paschbaer/thinking-mcp.git"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@smithery/sdk": "^1.4.3",
        "@types/better-sqlite3": "^9.6.0",
        "@xenova/transformers": "^2.17.2",
        "better-sqlite3": "^11.10.0",
        "express": "^4.18.2",
        "zod": "^3.25.27"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22",
        "@vitest/coverage-v8": "^1.2.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vitest": "^1.2.0"
    },
    "engines": {
        "node": ">=18"
    }
}
